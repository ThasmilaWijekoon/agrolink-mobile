<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgOrderProductAdmin"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_image"
                android:layout_marginRight="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtOrderIdAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order #1"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#000000"/>

                <TextView
                    android:id="@+id/txtOrderUserAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User: example@gmail.com"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/txtOrderContactAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact: 0771234567"
                    android:textSize="12sp"
                    android:textColor="#555555"/>

                <TextView
                    android:id="@+id/txtOrderAddressAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Address: Loading..."
                    android:textSize="12sp"
                    android:textColor="#555555"
                    android:maxLines="2"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/txtOrderItemsAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Items list here..."
                    android:textSize="12sp"
                    android:textColor="#D32F2F"
                    android:textStyle="italic"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/txtOrderTotalAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total: Rs. 0.00"
                    android:textColor="#388E3C"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/txtOrderStatusAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: PAID"
                    android:textStyle="bold|italic"
                    android:textSize="12sp"
                    android:textColor="#1976D2"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="end">

            <!-- ස්ථානය බැලීමට ඇති අලුත් බටන් එක -->
            <Button
                android:id="@+id/btnViewOnMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIEW ON MAP"
                android:textSize="10sp"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="#1976D2"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnOrderAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SHIP"
                android:textSize="10sp"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF"
                android:visibility="gone"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
